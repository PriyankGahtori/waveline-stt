# Copy to .env and edit locally. Shell environment variables override these values.
LOAD_WHISPER=true
LOAD_VOXTRAL=true
LOAD_VAANI=true
LOAD_NEMOTRON=false

WHISPER_MODEL=collabora/faster-whisper-medium-hindi
VOXTRAL_MODEL=mlx-community/Voxtral-Mini-4B-Realtime-2602-4bit
VAANI_MODEL=ARTPARK-IISc/whisper-medium-vaani-hindi
NEMOTRON_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b

# Whisper language code (e.g. hi, en). Empty = auto-detect.
WHISPER_LANGUAGE=hi

# Nemotron locale (e.g. hi-IN, en-US, auto). See prompt_dictionary in the model card.
NEMOTRON_LANGUAGE=hi-IN
# Device for Nemotron: auto (prefers cuda > mps > cpu), cpu, cuda, mps
NEMOTRON_DEVICE=auto
